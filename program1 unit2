#include <stdio.h>

int main(void) {
    int a = 10, b = 5, c = 2;

    printf("Demonstration of operator execution order\n");
    printf("--------------------------------------\n");

    printf("1) a + b * c = %d\n", a + b * c);      
    printf("2) (a + b) * c = %d\n", (a + b) * c);  
    printf("3) a / b * c = %d\n", a / b * c);      
    printf("4) a + b %% c = %d\n", a + b % c);      
    printf("5) a - b + c = %d\n", a - b + c);      
    printf("6) a * (b + c) = %d\n", a * (b + c));  

    printf("\nExplanation:\n");
    printf("- Operators with higher precedence are evaluated first.\n");
    printf("- If the precedence is the same, evaluation is from left to right.\n");
    printf("- Parentheses are always evaluated before the rest.\n");

    return 0;
}
